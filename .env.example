# PostgreSQL. Local native install (port 5432) or `docker compose up -d` (port 5433).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sneaker_rental?schema=public"

# Payments: mock until the gateway is chosen (OPEN DECISION: PayHere pre-auth support)
PAYMENT_GATEWAY="mock"

# Logistics: manual admin booking until a ride-hailing API is chosen
LOGISTICS_PROVIDER="manual"

# Signing secret for courier links (generate a long random string)
COURIER_LINK_SECRET="CHANGE_ME"
