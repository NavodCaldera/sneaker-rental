# PostgreSQL. `npm run db:start` runs local dev (5544) and test (5545) servers with no
# password; or point these at your own PostgreSQL / `docker compose up -d` (5433).
DATABASE_URL="postgres://postgres@localhost:5544/sneaker_rental"

# Connection pool size
DATABASE_POOL_MAX="10"

# Payments: mock until the gateway is chosen (OPEN DECISION: PayHere pre-auth support)
PAYMENT_GATEWAY="mock"

# Logistics: manual admin booking until a ride-hailing API is chosen
LOGISTICS_PROVIDER="manual"


# Integration and e2e tests run against a separate database that gets wiped.
TEST_DATABASE_URL="postgres://postgres@localhost:5545/sneaker_rental_test"

# Photo storage (local disk in development)
STORAGE_DIR=".data/uploads"

# Signs ride-hailing webhooks (HMAC-SHA256 of the body, hex, in x-signature)
LOGISTICS_WEBHOOK_SECRET="CHANGE_ME"

# Bearer token for POST /api/cron/payouts (weekly payout batch from a scheduler)
CRON_SECRET="CHANGE_ME"
