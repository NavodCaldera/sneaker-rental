# PostgreSQL: native install (5432), `docker compose up -d` (5433), or
# `npx prisma dev --name sneaker-rental --detach` (paste its TCP URL).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sneaker_rental?schema=public"

# Payments: mock until the gateway is chosen (OPEN DECISION: PayHere pre-auth support)
PAYMENT_GATEWAY="mock"

# Logistics: manual admin booking until a ride-hailing API is chosen
LOGISTICS_PROVIDER="manual"


# Integration tests run against a separate database that gets wiped.
# Local: `npx prisma dev --name sneaker-rental-test --detach`, then paste its TCP URL here.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Photo storage (local disk in development)
STORAGE_DIR=".data/uploads"
