// Data model: docs/business-model.md §8.
// Money and wear are Decimal, never Float (CLAUDE.md rule 2).
//   Charged / shown amounts:   @db.Decimal(14, 2)
//   Unrounded money:           @db.Decimal(28, 12)
//   Wear (wear-days):          @db.Decimal(28, 12)
//   Ratios (margins, φ, d):    @db.Decimal(20, 16)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

enum Role {
  MERCHANT
  BORROWER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String   @unique
  phone        String?
  /// The account's one address, entered at sign-up (customers and merchants; null for
  /// admins). Customers: where pairs are delivered and collected. Merchants: where drivers
  /// pick pairs up and bring them back. Trips copy it when they are booked.
  address      String?
  /// The town or city of that address, asked for separately at sign-up (both roles)
  city         String?
  /// Customers' age in years, asked at sign-up (null for merchants and admins). It is the age
  /// they gave when the account was created (`createdAt`).
  age          Int?
  passwordHash String
  verified     Boolean  @default(false)
  /// Locked after a lost shoe (§6)
  locked       Boolean  @default(false)
  /// Trusted borrower tier (Phase 2; stored now, no logic yet)
  tier         Int      @default(0)
  createdAt    DateTime @default(now())

  merchant         Merchant?
  sessions         Session[]
  passwordResets   PasswordReset[]
  rentals          Rental[]
  conditionReports ConditionReport[]
  disputesOpened   Dispute[]         @relation("DisputeOpenedBy")
  disputesDecided  Dispute[]         @relation("DisputeDecidedBy")
  walletEntries    WalletEntry[]
  payments         Payment[]
  notifications    Notification[]
  stylePacks       StylePack[]       @relation("StylePackCreatedBy")
  packsReviewed    StylePack[]       @relation("StylePackReviewedBy")
}

model Session {
  /// SHA-256 of the cookie token; the raw token is never stored
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A "forgot password" link, emailed to the account's address. Works once, for an hour.
model PasswordReset {
  /// SHA-256 of the emailed token; the raw token is never stored
  id        String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Merchant {
  id                    String   @id @default(cuid())
  userId                String   @unique
  businessName          String
  payoutAccount         String?
  verified              Boolean  @default(false)
  /// Longer maximum lifespan an admin granted on request (wear-days); null = settings max
  maxLifespanDays       Int?
  /// Wear at retirement ÷ declared L, averaged (Phase 2 ranking input)
  lifespanAccuracyScore Decimal? @db.Decimal(20, 16)
  createdAt             DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoes   Shoe[]
  payouts Payout[]
}

// ─── Catalogue ─────────────────────────────────────────────────────────────

enum ShoeStatus {
  DRAFT
  AVAILABLE
  RESERVED
  OUT_FOR_DELIVERY
  WITH_BORROWER
  IN_HANDOFF
  CLEANING
  RETIRED
  SOLD
}

enum Grade {
  A
  B
  C
  D
}

/// Who a pair is for. Unisex pairs show under Men and under Women.
enum Audience {
  MEN
  WOMEN
  UNISEX
  BOYS
  GIRLS
}

/// The size system on a pair's label (borrowers can also search by foot length in cm)
enum SizeSystem {
  UK
  EU
  US
}

/// How a pair's price falls with wear; the merchant picks one per listing
/// (pricing-spec.md §2). Fixed once the pair is published.
enum PricingMethod {
  /// S-curve (logistic decay): holds its price early, falls fastest around the midpoint,
  /// then levels off at the floor q
  LOGISTIC
  /// Exponential decay q^(w/L): falls fastest when new, reaching the floor q at L
  EXPONENTIAL
}

/// The condition a merchant declares when listing a pair
enum ShoeCondition {
  /// Brand new, never worn
  NEW
  /// Second-hand, as it is
  SECOND_HAND
  /// Second-hand with upgrades (e.g. new insoles, laces, sole work)
  SECOND_HAND_UPGRADED
}

model Shoe {
  id                String        @id @default(cuid())
  merchantId        String
  /// Brand and model are optional (product owner, 2026-10-12): "" when the merchant left them
  /// empty; shown through shoeName() ("Unbranded shoes" when both are empty)
  brand             String        @default("")
  model             String        @default("")
  /// The size as listed, e.g. "EU 39": the label system (sizeSystem) and its number
  size              String
  /// The size system on the pair's label, as the merchant listed it
  sizeSystem        SizeSystem    @default(UK)
  /// The same size in each system, from the size chart for who it's for
  /// (src/lib/shoe-size.ts). Off the chart (kids' pairs, sizes outside it) only the listed
  /// system is filled. Borrowers search by these.
  sizeUk            Decimal?      @db.Decimal(4, 1)
  sizeEu            Decimal?      @db.Decimal(4, 1)
  sizeUs            Decimal?      @db.Decimal(4, 1)
  /// Foot length in cm
  sizeCm            Decimal?      @db.Decimal(4, 1)
  /// Who it's for (shopping tabs: Men, Women, Boys, Girls)
  audience          Audience
  /// The experiences it's made for, one or more, e.g. ["Work Day", "Night Out"] (lists in
  /// src/lib/shoe-style.ts). Borrowers shop by any of them.
  experiences       String[]
  description       String?
  /// Declared value V (LKR)
  value             Decimal       @db.Decimal(14, 2)
  /// Expected lifespan L (wear-days)
  lifespanDays      Int
  /// Settled wear w (wear-days): updated when an item closes
  wear              Decimal       @default(0) @db.Decimal(28, 12)
  /// Settled wear plus the planned wear of every open booking (pricing-spec.md §6a): what
  /// listings show, and the wear the next borrower is priced at
  committedWear     Decimal       @default(0) @db.Decimal(28, 12)
  /// Condition the merchant declared when listing: brand new (w₀ = 0) or second-hand, with
  /// or without upgrades. Shown to borrowers; the price comes only from w₀.
  condition         ShoeCondition @default(NEW)
  /// What was upgraded (SECOND_HAND_UPGRADED only), e.g. "new insoles and laces"
  upgradeNotes      String?
  /// Wear already used when listed second-hand (w₀)
  initialWear       Decimal       @default(0) @db.Decimal(28, 12)
  /// Charged on the platform so far, after discounts (excludes F(w₀))
  collectedSoFar    Decimal       @default(0) @db.Decimal(28, 12)
  lostToDiscounts   Decimal       @default(0) @db.Decimal(28, 12)
  /// Merchant shares charged so far, net of refunds. Rent goes to the merchant until this
  /// reaches their target (merchant first), then to the platform.
  merchantCollected Decimal       @default(0) @db.Decimal(14, 2)
  /// The current or last holder's term end (or the day they ended early): the release
  /// discount counts from it
  releaseDay        DateTime?     @db.Date
  /// Price curve the merchant picked: S-curve (default) or exponential decay. Can change
  /// while a draft; fixed once published, so the curve never changes under a rental
  pricingMethod     PricingMethod @default(LOGISTIC)
  /// Settings version the shoe is priced with: snapshotted when listed, so its curve
  /// never changes under a running rental
  settingsId        String
  status            ShoeStatus    @default(DRAFT)
  latestGrade       Grade?
  publishedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  merchant         Merchant            @relation(fields: [merchantId], references: [id])
  settings         PricingSettings     @relation(fields: [settingsId], references: [id])
  photos           Photo[]
  rentalItems      RentalItem[]
  packRoles        StylePackRoleShoe[]
  conditionReports ConditionReport[]

  @@index([status, size, brand])
  @@index([merchantId])
}

enum PhotoKind {
  FRONT
  SIDE
  SOLE
  INSIDE
  BOX
  CONDITION
  DRIVER_PICKUP
  DRIVER_DROPOFF
}

model Photo {
  id                String    @id @default(cuid())
  kind              PhotoKind
  storageKey        String
  contentType       String
  shoeId            String?
  conditionReportId String?
  deliveryId        String?
  createdAt         DateTime  @default(now())

  shoe            Shoe?            @relation(fields: [shoeId], references: [id], onDelete: Cascade)
  conditionReport ConditionReport? @relation(fields: [conditionReportId], references: [id], onDelete: Cascade)
  delivery        Delivery?        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([shoeId])
}

// ─── Settings ──────────────────────────────────────────────────────────────

/// Append-only: the active row is the latest with effectiveFrom ≤ now.
model PricingSettings {
  id                    String   @id @default(cuid())
  effectiveFrom         DateTime @default(now())
  merchantMargin        Decimal  @db.Decimal(20, 16)
  platformMargin        Decimal  @db.Decimal(20, 16)
  floor                 Decimal  @db.Decimal(20, 16)
  midpointRatio         Decimal  @db.Decimal(20, 16)
  baseSteepness         Decimal  @db.Decimal(20, 16)
  /// Lifespan the base curve was tuned for: β = baseSteepness · refLife / L
  refLife               Int      @default(365)
  /// Lifespan a merchant may declare, in wear-days: 6 to 24 months. An admin can grant a
  /// merchant a longer maximum (Merchant.maxLifespanDays).
  minLifespanDays       Int      @default(180)
  maxLifespanDays       Int      @default(730)
  /// Highest discount a borrower can get (the release discount's cap)
  maxDiscount           Decimal  @default(0.10) @db.Decimal(20, 16)
  /// Release discount: shown from this many days before a holder's planned last day...
  releaseLeadDays       Int      @default(10)
  /// ...growing by this much a day, up to maxDiscount
  releaseDiscountStep   Decimal  @default(0.005) @db.Decimal(20, 16)
  /// Capital rate r (yearly) and hold cost h (LKR per idle day) for the idle-cost test
  capitalRate           Decimal  @default(0.12) @db.Decimal(20, 16)
  holdCost              Decimal  @default(0) @db.Decimal(20, 16)
  /// OPEN DECISION: hours a reserved-next borrower has to accept a higher price after an
  /// early return, before the reservation is cancelled
  offerResponseHours    Int      @default(24)
  /// An early return must be asked for at least this many days before the new last day
  earlyReturnNoticeDays Int      @default(10)
  maxPairsPerBundle     Int
  disputeWindowDays     Int
  freeReturnHours       Int
  /// Catch-up pricing (OPEN DECISION; off at launch)
  catchUpEnabled        Boolean  @default(false)
  /// After a pair reaches its lifespan L, keep counting wear and charge the end-of-life price
  /// P(L) per wear-day until it is returned, even past the target R (off = reference engine)
  chargePastLife        Boolean  @default(true)
  createdById           String?
  createdAt             DateTime @default(now())

  shoes Shoe[]

  @@index([effectiveFrom])
}

// ─── Booking ───────────────────────────────────────────────────────────────

enum RentalStatus {
  PENDING_PAYMENT
  ACTIVE
  CLOSED
  CANCELLED
}

model Rental {
  id            String       @id @default(cuid())
  borrowerId    String
  status        RentalStatus @default(PENDING_PAYMENT)
  /// Rent estimate for the booked terms, locked at booking (charged per item when it closes)
  estimatedRent Decimal      @db.Decimal(14, 2)
  /// Merchant value of the pairs (Σ V), locked in tokens while they are out
  shoeValue     Decimal      @db.Decimal(14, 2)
  createdAt     DateTime     @default(now())
  closedAt      DateTime?

  borrower      User          @relation(fields: [borrowerId], references: [id])
  items         RentalItem[]
  payments      Payment[]
  walletEntries WalletEntry[]

  @@index([borrowerId, status])
}

enum RentalItemStatus {
  /// Booked, waiting for the delivery from the merchant
  AWAITING_DELIVERY
  /// Reserved while another borrower holds the pair (direct handoff queue)
  WAITING_HANDOFF
  /// With the borrower; the wear clock is running
  ACTIVE
  /// Borrower ended it; collection or handoff in progress
  RETURNING
  CLOSED
  CANCELLED
  LOST
}

enum DiscountFunding {
  PLATFORM
  MERCHANT
}

model RentalItem {
  id                String           @id @default(cuid())
  rentalId          String
  shoeId            String
  status            RentalItemStatus @default(AWAITING_DELIVERY)
  /// When the pair reached this borrower, and when it reached the next holder
  startDate         DateTime?
  endDate           DateTime?
  /// Wear-ledger days, both inclusive (Asia/Colombo calendar dates): first = the day after
  /// delivery (day 1 of the term), last = the day the borrower ended the rental or the
  /// term's last day (waiting for pickup is free).
  firstDay          DateTime?        @db.Date
  lastDay           DateTime?        @db.Date
  returnRequestedAt DateTime?
  /// The term booked, in days (plus extensions)
  plannedDays       Int?
  /// The term's last day = firstDay + plannedDays − 1 (set on delivery; an early return
  /// moves it forward)
  termEndDay        DateTime?        @db.Date
  /// When the borrower gave notice of an early return (the new last day is termEndDay)
  earlyReturnAt     DateTime?
  /// A reservation on this pair was declined (or not answered) after an early return: when
  /// this holding ends the pair stays with the borrower, free, until a new borrower books it,
  /// then goes to them by direct handoff (never back to the merchant meanwhile)
  holdForNext       Boolean          @default(false)
  /// The plan (pricing-spec.md §6a): first day, wear before and after the planned term, and
  /// its rent. For a reservation these are what the borrower agreed to.
  plannedFirstDay   DateTime?        @db.Date
  plannedWearStart  Decimal?         @db.Decimal(28, 12)
  plannedWearEnd    Decimal?         @db.Decimal(28, 12)
  plannedCharge     Decimal?         @db.Decimal(14, 2)
  /// Tokens locked for the rent estimate (plannedCharge less anything already charged)
  rentLocked        Decimal          @default(0) @db.Decimal(14, 2)
  /// Rent tokens charged for this item, net of refunds: 0 until it closes, then the charge
  rentPaid          Decimal          @default(0) @db.Decimal(14, 2)
  /// New dates and price a reserved-next borrower must accept (the holder returns early)
  offerFirstDay     DateTime?        @db.Date
  offerCharge       Decimal?         @db.Decimal(14, 2)
  offerWearStart    Decimal?         @db.Decimal(28, 12)
  offerDueAt        DateTime?
  wearStart         Decimal?         @db.Decimal(28, 12)
  wearEnd           Decimal?         @db.Decimal(28, 12)
  discount          Decimal          @default(0) @db.Decimal(20, 16)
  discountFunding   DiscountFunding?
  phi               Decimal          @default(1) @db.Decimal(20, 16)
  /// Unrounded charge and discount cost from the pricing engine
  chargeExact       Decimal?         @db.Decimal(28, 12)
  discountCost      Decimal?         @db.Decimal(28, 12)
  /// Charged amounts (2 dp)
  charge            Decimal?         @db.Decimal(14, 2)
  merchantShare     Decimal?         @db.Decimal(14, 2)
  platformShare     Decimal?         @db.Decimal(14, 2)
  /// Free return within freeReturnHours of delivery (wrong size/fit)
  freeReturn        Boolean          @default(false)
  closedAt          DateTime?
  /// closedAt + dispute window; merchant share is payable after this
  payableAt         DateTime?
  payoutId          String?
  createdAt         DateTime         @default(now())

  rental           Rental            @relation(fields: [rentalId], references: [id])
  shoe             Shoe              @relation(fields: [shoeId], references: [id])
  payout           Payout?           @relation(fields: [payoutId], references: [id])
  deliveries       Delivery[]        @relation("DeliveryTo")
  outgoing         Delivery[]        @relation("DeliveryFrom")
  conditionReports ConditionReport[]
  disputes         Dispute[]
  payments         Payment[]
  walletEntries    WalletEntry[]

  @@index([shoeId, status])
  @@index([status, payableAt])
  @@index([status, termEndDay])
}

// ─── Logistics ─────────────────────────────────────────────────────────────

enum DeliveryType {
  /// Merchant → borrower
  DELIVER
  /// Borrower → merchant
  COLLECT
  /// Borrower → next borrower (sealed bag + cleaning kit)
  HANDOFF
}

enum DeliveryStatus {
  REQUESTED
  QUOTED
  BOOKED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

/// Who pays the ride-hailing driver, directly in the app: whoever receives the pair. The
/// platform never charges or collects trip fees.
enum PartyPays {
  BORROWER
  MERCHANT
}

model Delivery {
  id                   String         @id @default(cuid())
  type                 DeliveryType
  status               DeliveryStatus @default(REQUESTED)
  provider             String
  externalRef          String?
  /// Item receiving the shoe (DELIVER, HANDOFF) or returning it (COLLECT)
  rentalItemId         String
  /// For HANDOFF: the item handing the shoe over
  fromRentalItemId     String?
  fromAddress          String
  toAddress            String
  /// The ride-hailing app's quoted trip fee, for information: the receiver pays it to the
  /// driver directly, never through us
  quote                Decimal?       @db.Decimal(14, 2)
  /// The receiver: the borrower for DELIVER and HANDOFF, the merchant for COLLECT
  paidBy               PartyPays      @default(BORROWER)
  /// SHA-256 of the courier link token
  courierTokenHash     String?        @unique
  courierTokenExpiry   DateTime?
  sealedBagConfirmed   Boolean        @default(false)
  cleaningKitConfirmed Boolean        @default(false)
  bookedAt             DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  /// Append-only trip log: [{ at, status, note }]
  tripLog              Json           @default("[]")
  createdAt            DateTime       @default(now())

  rentalItem     RentalItem  @relation("DeliveryTo", fields: [rentalItemId], references: [id])
  fromRentalItem RentalItem? @relation("DeliveryFrom", fields: [fromRentalItemId], references: [id])
  photos         Photo[]

  @@index([status])
  @@index([rentalItemId])
}

// ─── Condition ─────────────────────────────────────────────────────────────

enum ConditionStage {
  /// Borrower confirms on receipt (starts the clock)
  RECEIPT
  /// Merchant or next borrower records on return / handoff (closes the item)
  RETURN
}

model ConditionReport {
  id           String         @id @default(cuid())
  shoeId       String
  rentalItemId String?
  recordedById String
  stage        ConditionStage
  grade        Grade
  notes        String?
  damageFlag   Boolean        @default(false)
  createdAt    DateTime       @default(now())

  shoe       Shoe        @relation(fields: [shoeId], references: [id])
  rentalItem RentalItem? @relation(fields: [rentalItemId], references: [id])
  recordedBy User        @relation(fields: [recordedById], references: [id])
  photos     Photo[]

  @@index([shoeId])
}

// ─── Payments, payouts, disputes ───────────────────────────────────────────

enum PaymentKind {
  /// Card → tokens (a sale through the gateway)
  TOP_UP
  /// Tokens → card (a refund of an earlier top-up)
  WITHDRAWAL
  // Card holds and deposits before tokens replaced them (history only)
  PREAUTH
  PREAUTH_VOID
  CAPTURE
  DEPOSIT_HOLD
  DEPOSIT_RELEASE
  DEPOSIT_CAPTURE
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A call to the payment gateway: token top-ups and withdrawals (and, before tokens,
/// card holds and captures).
model Payment {
  id             String        @id @default(cuid())
  userId         String
  rentalId       String?
  rentalItemId   String?
  kind           PaymentKind
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  gateway        String
  gatewayRef     String?
  idempotencyKey String        @unique
  note           String?
  /// For a WITHDRAWAL: the top-up it refunds (refunds go back to the card that paid)
  refundOfId     String?
  createdAt      DateTime      @default(now())

  refundOf      Payment?      @relation("PaymentRefunds", fields: [refundOfId], references: [id])
  refunds       Payment[]     @relation("PaymentRefunds")
  user          User          @relation(fields: [userId], references: [id])
  rental        Rental?       @relation(fields: [rentalId], references: [id])
  rentalItem    RentalItem?   @relation(fields: [rentalItemId], references: [id])
  walletEntries WalletEntry[]

  @@index([rentalId])
  @@index([userId])
}

// ─── Tokens ────────────────────────────────────────────────────────────────

/// Append-only token ledger (1 token = 1 LKR). Balance = top-ups + credits − charges −
/// withdrawals; locked = locks − unlocks; available = balance − locked.
enum WalletEntryKind {
  /// Paid in through the gateway (+balance)
  TOP_UP
  /// Refunded to the card (−balance)
  WITHDRAWAL
  /// Reserved for a rental: a pair's value (deposit) or its rent estimate (+locked)
  LOCK
  /// Released from a rental (−locked)
  UNLOCK
  /// Rent when an item closes, damage or a lost pair (−balance; trip fees never go through tokens). A charge taken from a pair's
  /// deposit is written with a matching UNLOCK.
  CHARGE
  /// Given back, e.g. an upheld overcharge (+balance)
  CREDIT
}

/// Why tokens are locked: a pair's deposit (its value V) or the rent estimate for its term
enum LockPurpose {
  DEPOSIT
  RENT
}

model WalletEntry {
  id             String          @id @default(cuid())
  userId         String
  kind           WalletEntryKind
  /// Always positive; the kind gives the direction
  amount         Decimal         @db.Decimal(14, 2)
  rentalId       String?
  rentalItemId   String?
  /// LOCK / UNLOCK only: what the tokens are held for
  purpose        LockPurpose?
  paymentId      String?
  note           String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  user       User        @relation(fields: [userId], references: [id])
  rental     Rental?     @relation(fields: [rentalId], references: [id])
  rentalItem RentalItem? @relation(fields: [rentalItemId], references: [id])
  payment    Payment?    @relation(fields: [paymentId], references: [id])

  @@index([userId, kind])
  @@index([rentalId, kind])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model Payout {
  id         String       @id @default(cuid())
  merchantId String
  amount     Decimal      @db.Decimal(14, 2)
  status     PayoutStatus @default(PENDING)
  /// Batch key, e.g. the ISO week "2026-W41"
  batchKey   String
  reference  String?
  createdAt  DateTime     @default(now())
  paidAt     DateTime?

  merchant Merchant     @relation(fields: [merchantId], references: [id])
  items    RentalItem[]

  @@unique([merchantId, batchKey])
}

enum DisputeStatus {
  OPEN
  UPHELD
  REJECTED
}

enum DisputeResolution {
  /// Damage or loss: capture from the borrower's deposit; paid to the merchant
  CHARGE_DEPOSIT
  /// Overcharge: refund the borrower; deducted from the merchant's share
  REFUND_BORROWER
  NO_ACTION
}

model Dispute {
  id           String             @id @default(cuid())
  rentalItemId String
  openedById   String
  reason       String
  status       DisputeStatus      @default(OPEN)
  resolution   DisputeResolution?
  /// Amount actually captured (CHARGE_DEPOSIT) or refunded (REFUND_BORROWER)
  amount       Decimal?           @db.Decimal(14, 2)
  decision     String?
  decidedById  String?
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?

  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id])
  openedBy   User       @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  decidedBy  User?      @relation("DisputeDecidedBy", fields: [decidedById], references: [id])

  @@index([status])
}

// ─── Notifications ─────────────────────────────────────────────────────────

enum NotificationKind {
  /// A reserved pair came back early and costs more: accept or reject
  PRICE_OFFER
  /// A reservation was cancelled (offer rejected or expired, pair retired)
  RESERVATION_CANCELLED
  /// Tokens given back (unused days, a lower price)
  REFUND
  /// The term ended and a driver is on the way
  TERM_ENDED
  /// An admin approved, rejected or unpublished a merchant's style pack
  STYLE_PACK
}

/// In-app notice, also sent by email (an outbox: emailedAt is set once sent).
model Notification {
  id           String           @id @default(cuid())
  userId       String
  kind         NotificationKind
  title        String
  body         String
  link         String?
  rentalItemId String?
  readAt       DateTime?
  emailedAt    DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([emailedAt])
}

/// Where a style pack is: merchants' packs need an admin's approval before borrowers see them
/// (product owner, 2026-10-13); an admin's own packs publish directly.
enum StylePackStatus {
  /// Being written; only its maker and admins see it
  DRAFT
  /// A merchant asked for it to be published; waiting for an admin
  SUBMITTED
  /// On the home page and its own page (/packs/[id])
  PUBLISHED
  /// An admin turned it down (reviewNote says why); the merchant can edit and resubmit
  REJECTED
}

/// A curated rotation of pairs ("The Marathon & Active Recovery"), made by a merchant or an
/// admin. Each role is one pair in the rotation, with listed pairs to choose from. Packs carry
/// no price of their own: every pair is rented at its own curve price (no pack discount).
model StylePack {
  id           String          @id @default(cuid())
  title        String
  /// One line under the title
  subtitle     String          @default("")
  /// "Rotation Advantage" box, e.g. "Hold 3 pairs · wear splits 3 ways"
  highlight    String          @default("")
  status       StylePackStatus @default(DRAFT)
  /// Why an admin rejected or unpublished it
  reviewNote   String?
  createdById  String
  reviewedById String?
  submittedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy  User            @relation("StylePackCreatedBy", fields: [createdById], references: [id])
  reviewedBy User?           @relation("StylePackReviewedBy", fields: [reviewedById], references: [id])
  roles      StylePackRole[]

  @@index([status, publishedAt])
  @@index([createdById])
}

/// One pair's place in a rotation ("Speed & Tempo Day"), in order.
model StylePackRole {
  id          String  @id @default(cuid())
  packId      String
  position    Int
  name        String
  description String  @default("")
  /// An experience from src/lib/shoe-style.ts, or null
  experience  String?

  pack  StylePack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  shoes StylePackRoleShoe[]

  @@unique([packId, position])
}

/// A listed pair that fills a role, in order. Any merchant's pairs can be used.
model StylePackRoleShoe {
  roleId   String
  shoeId   String
  position Int

  role StylePackRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  shoe Shoe          @relation(fields: [shoeId], references: [id], onDelete: Cascade)

  @@id([roleId, shoeId])
  @@index([shoeId])
}
